{
  "manifest_version": 3,
  "name": "Trackezz",
  "version": "1.0.0",
  "description": "Automatically track job applications from LinkedIn, Naukri, Internshala & more. Gmail integration for status updates.",
  "permissions": [
    "storage",
    "notifications",
    "identity",
    "alarms",
    "tabs",
    "windows",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.linkedin.com/jobs-tracker/*",
    "https://www.naukri.com/*",
    "https://internshala.com/*",
    "https://www.indeed.com/*",
    "https://in.indeed.com/*",
    "https://myjobs.indeed.com/*",
    "https://unstop.com/*",
    "https://www.glassdoor.co.in/*",
    "https://www.glassdoor.com/*",
    "https://mail.google.com/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content-scripts/utils.js", "content-scripts/linkedin.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.naukri.com/*"],
      "js": ["content-scripts/utils.js", "content-scripts/naukri.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://internshala.com/*"],
      "js": ["content-scripts/utils.js", "content-scripts/internshala.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.indeed.com/*", "https://in.indeed.com/*", "https://myjobs.indeed.com/*"],
      "js": ["content-scripts/utils.js", "content-scripts/indeed.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://unstop.com/*"],
      "js": ["content-scripts/utils.js", "content-scripts/unstop.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.glassdoor.co.in/*", "https://www.glassdoor.com/*"],
      "js": ["content-scripts/utils.js", "content-scripts/glassdoor.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}
